# Ansible retry files (generated when a playbook fails)
ansible/**/*.retry

# Ansible execution log
ansible/ansible.log

# Private CA offline signing kit: `step` is a 42 MB upstream binary, not stored in git.
# Assemble it on the way in — see docs/private-ca-offline-signing/01-building-step.md
docs/private-ca-offline-signing/step

# Private CA ceremony output — the certificates go to the CA host and the root travels via Key Vault
# (#144); none of it belongs in the repo.
docs/private-ca-offline-signing/*.crt
docs/private-ca-offline-signing/root_ca_fingerprint

