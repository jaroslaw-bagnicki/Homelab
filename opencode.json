{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "deepseek": {
      "name": "DeepSeek"
    },
    "minimax-coding-plan": {
      "name": "MiniMax (coding plan)"
    }
  },
  "mcp": {
    "github-mcp": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GH_PAT}"
      }
    },
    "azure-mcp": {
      "type": "local",
      "command": ["uvx", "--from", "msmcp-azure", "azmcp", "server", "start"],
      "environment": {
        "AZURE_TENANT_ID":     "{env:AZURE_TENANT_ID}",
        "AZURE_CLIENT_ID":     "{env:AZURE_CLIENT_ID}",
        "AZURE_CLIENT_SECRET": "{env:AZURE_CLIENT_SECRET}"
      },
      "enabled": false,
      "__comment": "Blocked on Alpine/musl (glibc binary). Unblocks when k3s migration (#44) lands — azmcp runs as a sidecar container in the same pod (glibc base), reachable at localhost."
    }
  }
}