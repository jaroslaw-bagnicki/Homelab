{
    auto_https disable_redirects
}

{% for site in edge_host_caddy_sites %}
{{ site.name }} {
    tls {
        issuer acme {
            dir {{ edge_host_caddy_ca_url }}
            test_dir {{ edge_host_caddy_ca_url }}
            trusted_roots {{ edge_host_caddy_ca_root_path }}
            disable_http_challenge
        }
    }

    reverse_proxy {{ site.upstream }}{% if site.tls_skip_verify | default(false) %} {
        transport http {
            tls_insecure_skip_verify
        }
    }{% endif %}

}
{% endfor %}
