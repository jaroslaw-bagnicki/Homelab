[Unit]
Description=Technitium DNS Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ edge_host_technitium_user }}
Group={{ edge_host_technitium_group }}
SyslogIdentifier=dns-server

WorkingDirectory={{ edge_host_technitium_install_dir }}
ReadWritePaths={{ edge_host_technitium_config_dir }} {{ edge_host_technitium_log_dir }}

Environment="OPENSSL_ENABLE_SHA1_SIGNATURES=1"

ExecStart=/usr/bin/dotnet {{ edge_host_technitium_install_dir }}/DnsServerApp.dll {{ edge_host_technitium_config_dir }}

Restart=always
RestartSec=10

LockPersonality=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RemoveIPC=true
RestrictRealtime=true
RestrictSUIDSGID=true

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

UMask=0077

[Install]
WantedBy=multi-user.target
