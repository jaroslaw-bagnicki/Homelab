[SERVICE]
    Flush                    {{ fluentbit_flush }}
    Daemon                   Off
    Log_Level                {{ fluentbit_log_level }}
    Parsers_File             {{ fluentbit_parsers_file }}
    Parsers_File             {{ fluentbit_custom_parsers_file }}
    storage.path             {{ fluentbit_runtime_dir }}
    storage.sync             normal
    storage.checksum         off
{% if fluentbit_collect_journald %}

# journald — the whole journal, no inclusion list and no priority filter (ADR 36).
[INPUT]
    Name                     systemd
    Tag                      journal.*
    DB                       {{ fluentbit_runtime_dir }}/journal.db
    Read_From_Tail           {{ 'On' if fluentbit_read_from_tail | bool else 'Off' }}
    Max_Entries              {{ fluentbit_journald_max_entries }}
    Storage.Type             {{ fluentbit_buffer_type }}
{% if fluentbit_buffer_type != 'filesystem' %}
    Mem_Buf_Limit            {{ fluentbit_buffer_limit }}
{% endif %}

# PRIORITY is a bare syslog number; derive the readable `level` VictoriaLogs displays and filters
# on. `level` stays a regular field — it varies per line and must never join `_stream_fields`.
[FILTER]
    Name                     lua
    Match                    journal.*
    Script                   {{ fluentbit_lua_level_script }}
    Call                     map_level

[OUTPUT]
    Name                     http
    Match                    journal.*
    Host                     {{ fluentbit_store_host }}
    Port                     {{ fluentbit_store_port }}
    URI                      {{ fluentbit_store_uri }}?_stream_fields=_HOSTNAME,_SYSTEMD_UNIT&_msg_field=MESSAGE&_time_field=date{{ '&debug=1' if fluentbit_store_debug | bool else '' }}
    Format                   json_lines
    Json_date_format         iso8601
    tls                      On
    tls.verify               Off
    http_user                {{ fluentbit_store_username }}
    http_passwd              {{ fluentbit_store_password }}
    compress                 gzip
    Retry_Limit              False
{% if fluentbit_buffer_type == 'filesystem' %}
    storage.total_limit_size {{ fluentbit_buffer_limit }}
{% endif %}
{% endif %}
{% if fluentbit_collect_docker %}

# Docker json-file logs — the built-in `docker` parser unwraps the JSON envelope; the log file
# path supplies the container id the envelope does not carry (ADR 36 §9).
[INPUT]
    Name                     tail
    Tag                      docker.*
    Path                     {{ fluentbit_docker_glob }}
    Parser                   docker
    DB                       {{ fluentbit_runtime_dir }}/docker.db
    Read_from_Head           false
    Docker_Mode              On
    Docker_Mode_Flush        5
    Path_Key                 container_log
    Storage.Type             {{ fluentbit_buffer_type }}
{% if fluentbit_buffer_type != 'filesystem' %}
    Mem_Buf_Limit            {{ fluentbit_buffer_limit }}
{% endif %}

[FILTER]
    Name                     parser
    Match                    docker.*
    Key_Name                 container_log
    Parser                   docker_path
    Reserve_Data             On

[FILTER]
    Name                     record_modifier
    Match                    docker.*
    Record                   hostname {{ inventory_hostname }}
    Remove_key               container_log

[OUTPUT]
    Name                     http
    Match                    docker.*
    Host                     {{ fluentbit_store_host }}
    Port                     {{ fluentbit_store_port }}
    URI                      {{ fluentbit_store_uri }}?_stream_fields=hostname,container_id&_msg_field=log&_time_field=date{{ '&debug=1' if fluentbit_store_debug | bool else '' }}
    Format                   json_lines
    Json_date_format         iso8601
    tls                      On
    tls.verify               Off
    http_user                {{ fluentbit_store_username }}
    http_passwd              {{ fluentbit_store_password }}
    compress                 gzip
    Retry_Limit              False
{% if fluentbit_buffer_type == 'filesystem' %}
    storage.total_limit_size {{ fluentbit_buffer_limit }}
{% endif %}
{% endif %}
{% for path in fluentbit_file_paths %}

# Native file logs — raw lines, source-specific paths (ADR 36 §9).
[INPUT]
    Name                     tail
    Tag                      file.{{ loop.index }}.*
    Path                     {{ path }}
    DB                       {{ fluentbit_runtime_dir }}/file-{{ loop.index }}.db
    Read_from_Head           false
    Storage.Type             {{ fluentbit_buffer_type }}
{% if fluentbit_buffer_type != 'filesystem' %}
    Mem_Buf_Limit            {{ fluentbit_buffer_limit }}
{% endif %}

[FILTER]
    Name                     record_modifier
    Match                    file.{{ loop.index }}.*
    Record                   hostname {{ inventory_hostname }}

[OUTPUT]
    Name                     http
    Match                    file.{{ loop.index }}.*
    Host                     {{ fluentbit_store_host }}
    Port                     {{ fluentbit_store_port }}
    URI                      {{ fluentbit_store_uri }}?_stream_fields=hostname&_msg_field=log&_time_field=date{{ '&debug=1' if fluentbit_store_debug | bool else '' }}
    Format                   json_lines
    Json_date_format         iso8601
    tls                      On
    tls.verify               Off
    http_user                {{ fluentbit_store_username }}
    http_passwd              {{ fluentbit_store_password }}
    compress                 gzip
    Retry_Limit              False
{% if fluentbit_buffer_type == 'filesystem' %}
    storage.total_limit_size {{ fluentbit_buffer_limit }}
{% endif %}
{% endfor %}
