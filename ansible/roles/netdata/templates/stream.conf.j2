# Managed by Ansible — Netdata streaming (shared netdata role, ADR 27).
{% if netdata_role == 'parent' %}
# Parent: accept streams authenticated with the shared API key.
[{{ netdata_stream_api_key }}]
    enabled = yes
{% elif netdata_stream_target | length > 0 %}
# Child: stream local metrics to the parent.
[stream]
    enabled = yes
    destination = {{ netdata_stream_target }}{{ ':SSL' if netdata_stream_ssl | bool else '' }}
    api key = {{ netdata_stream_api_key }}
{% if netdata_stream_ssl | bool %}
    # The parent's certificate is self-signed: the hop is encrypted, but its identity is
    # not verified. Pinning it via CAfile is the tracked follow-up (ADR 27).
    ssl skip certificate verification = yes
{% endif %}
{% endif %}
