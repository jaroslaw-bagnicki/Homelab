#!/bin/sh
set -eu

CERT="{{ security_ssh_host_cert }}"
KEY="{{ security_ssh_host_key }}"
ROOT="{{ security_ssh_resolved_root }}"
CA_URL="{{ security_ssh_ca_url }}"
THRESHOLD="{{ security_ssh_renew_before_seconds }}"
TAG="homelab-ssh-host-cert"

# The playbook passes --no-restart: it reissues the certificate itself and already queues a
# `Restart ssh` handler, so restarting here as well would drop the connection twice in one
# run. The timer calls the script bare and stays self-healing.
RESTART=1
[ "${1:-}" = "--no-restart" ] && RESTART=0

[ -f "$CERT" ] || { logger -t "$TAG" -p user.err "host certificate missing"; exit 1; }
[ -n "$ROOT" ] && [ -f "$ROOT" ] || { logger -t "$TAG" -p user.err "CA root missing"; exit 1; }

EXPIRES=$(ssh-keygen -L -f "$CERT" | awk '/Valid:/{print $NF}')
if ! EXPIRES_EPOCH=$(date -d "$EXPIRES" +%s); then
  logger -t "$TAG" -p user.err "cannot parse certificate expiry: $EXPIRES"
  exit 1
fi
NOW=$(date +%s)

# sshd reads the host certificate once, at start, and keeps serving the copy it loaded. A
# certificate replaced by any path other than this script — a manual `step ssh renew`, a
# restored backup — is never read, so clients print "Certificate invalid: expired" while still
# connecting. Nothing fails loudly.
#
# The reload lives in the two branches below rather than here, because a certificate can be
# both stale *and* due for renewal: restarting up front would drop the connection, then the
# renewal would write a new certificate and restart again. Exactly one restart per run.
SSHD_START=$(systemctl show ssh -p ActiveEnterTimestamp --value 2>/dev/null || true)
SSHD_START_EPOCH=$(date -d "${SSHD_START:-@0}" +%s 2>/dev/null || echo 0)

# Re-read the mtime each call: `step ssh renew` rewrites the file, so a value captured once
# would be stale by the time the failure path runs.
reload_if_stale() {
  if [ "$RESTART" = 1 ] && [ "$(stat -c %Y "$CERT")" -gt "$SSHD_START_EPOCH" ]; then
    systemctl restart ssh
    logger -t "$TAG" -p user.warn "sshd was serving a stale host certificate; reloaded"
  fi
}

if [ $((EXPIRES_EPOCH - NOW)) -gt "$THRESHOLD" ]; then
  # Not due for renewal: the only reason to restart is an out-of-band replacement.
  reload_if_stale
  exit 0
fi

# step's flag parser stops at the first positional argument, so -f must follow
# the two positional paths — `step ssh renew -f <cert> <key>` is rejected with
# "too many positional arguments" and the renewal silently never runs.
if ! step ssh renew "$CERT" "$KEY" -f --ca-url "$CA_URL" --root "$ROOT"; then
  logger -t "$TAG" -p user.crit "host certificate renewal failed"
  # The file on disk may still be a newer out-of-band replacement that sshd never loaded,
  # so recover what we can before failing.
  reload_if_stale
  exit 1
fi

# A SIGHUP re-exec fails where ssh.socket owns the port, so restart the unit.
if [ "$RESTART" = 1 ]; then
  systemctl restart ssh
fi
logger -t "$TAG" -p user.info "host certificate renewed"
