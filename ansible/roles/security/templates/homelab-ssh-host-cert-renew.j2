#!/bin/sh
set -eu

CERT="{{ security_ssh_host_cert }}"
KEY="{{ security_ssh_host_key }}"
ROOT="{{ security_ssh_resolved_root }}"
CA_URL="{{ security_ssh_ca_url }}"
THRESHOLD="{{ security_ssh_renew_before_seconds }}"
TAG="homelab-ssh-host-cert"

[ -f "$CERT" ] || { logger -t "$TAG" -p user.err "host certificate missing"; exit 1; }
[ -n "$ROOT" ] && [ -f "$ROOT" ] || { logger -t "$TAG" -p user.err "CA root missing"; exit 1; }

EXPIRES=$(ssh-keygen -L -f "$CERT" | awk '/Valid:/{print $NF}')
if ! EXPIRES_EPOCH=$(date -d "$EXPIRES" +%s); then
  logger -t "$TAG" -p user.err "cannot parse certificate expiry: $EXPIRES"
  exit 1
fi
NOW=$(date +%s)

# sshd reads the host certificate once, at start. A certificate replaced by any path other
# than this script — a manual `step ssh renew`, a restored backup — leaves sshd serving the
# old one until it restarts. An expired certificate is served silently: clients warn but the
# connection still succeeds, so nothing fails loudly. Compare the file's mtime against the
# running sshd's start time and reload when the file is newer, before the early return below
# skips the renewal branch entirely.
SSHD_START=$(systemctl show ssh -p ActiveEnterTimestamp --value 2>/dev/null || true)
SSHD_START_EPOCH=$(date -d "${SSHD_START:-@0}" +%s 2>/dev/null || echo 0)
if [ "$(stat -c %Y "$CERT")" -gt "$SSHD_START_EPOCH" ]; then
  systemctl restart ssh
  logger -t "$TAG" -p user.warn "sshd was serving a stale host certificate; reloaded"
fi

if [ $((EXPIRES_EPOCH - NOW)) -gt "$THRESHOLD" ]; then
  exit 0
fi

# step's flag parser stops at the first positional argument, so -f must follow
# the two positional paths — `step ssh renew -f <cert> <key>` is rejected with
# "too many positional arguments" and the renewal silently never runs.
if ! step ssh renew "$CERT" "$KEY" -f --ca-url "$CA_URL" --root "$ROOT"; then
  logger -t "$TAG" -p user.crit "host certificate renewal failed"
  exit 1
fi

# A SIGHUP re-exec fails where ssh.socket owns the port, so restart the unit.
systemctl restart ssh
logger -t "$TAG" -p user.info "host certificate renewed"
