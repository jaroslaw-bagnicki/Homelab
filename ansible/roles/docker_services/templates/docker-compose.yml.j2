services:
{% if 'portainer' in docker_services_enabled %}
  portainer:
    image: portainer/portainer-ce:latest
    container_name: portainer
    restart: always
    command: --no-setup-token
    ports:
      - "127.0.0.1:9000:9000"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - portainer_data:/data
    networks:
      - homelab_net
{% endif %}
{% if 'caddy' in docker_services_enabled %}
  caddy:
    image: caddy:2-alpine
    container_name: caddy
    restart: always
    ports:
      # Origin listener for the public zone: the edge Caddy proxies here (ADR 24 (2026-11-14 amendment)).
      - "{{ docker_services_caddy_bind }}"
    volumes:
      - "{{ docker_dir }}/Caddyfile:/etc/caddy/Caddyfile:ro"
    networks:
      - homelab_net
      - opencode_net
{% endif %}
{% if 'hello' in docker_services_enabled %}
  hello:
    image: nginxdemos/hello:latest
    container_name: hello
    restart: always
    networks:
      - homelab_net
{% endif %}
volumes:
{% if 'portainer' in docker_services_enabled %}
  portainer_data:
    # Pinned, so a volume cloned from another host is adopted as-is instead of
    # landing under the compose project prefix (<project>_portainer_data).
    name: portainer_data
{% endif %}

networks:
  homelab_net:
    name: homelab_net
{% if 'caddy' in docker_services_enabled %}
  opencode_net:
    external: true
    name: opencode_net
{% endif %}
