services:
  portainer:
    image: portainer/portainer-ce:latest
    container_name: portainer
    restart: always
    command: --no-setup-token
    ports:
      - "127.0.0.1:9000:9000"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - portainer_data:/data
    networks:
      - homelab_net

  caddy:
    image: caddy:2-alpine
    container_name: caddy
    restart: always
    ports:
      # Origin listener for the public zone: the edge Caddy proxies here (ADR 53).
      - "{{ docker_services_caddy_bind }}"
    volumes:
      - "{{ docker_dir }}/Caddyfile:/etc/caddy/Caddyfile:ro"
    networks:
      - homelab_net
      - opencode_net

  hello:
    image: nginxdemos/hello:latest
    container_name: hello
    restart: always
    networks:
      - homelab_net

volumes:
  portainer_data:

networks:
  homelab_net:
    name: homelab_net
  opencode_net:
    external: true
    name: opencode_net
