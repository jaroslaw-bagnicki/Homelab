# Origin Caddy for both zones. The edge proxy terminates TLS and hands the whole
# hostname here with `Host` preserved (ADR 24 (2026-11-14 amendment)), so this file
# routes by *service label* and never names a domain: adding a zone is an edge-side
# change only (runbook 47 §3a-bis).
http://cloud5.ovh:8080 {
    respond "lab — {host} — {time.now}"
}

:8080 {
    route {
        @portainer expression {http.request.host}.startsWith('portainer.')
        handle @portainer {
            reverse_proxy portainer:9000 {
                header_up X-Forwarded-Proto https
            }
        }

        @zot expression {http.request.host}.startsWith('zot.')
        handle @zot {
            reverse_proxy zot:5000
        }

        @hello expression {http.request.host}.startsWith('hello.')
        handle @hello {
            reverse_proxy hello:80
        }

        # OpenCode instances — `<inst>-oc.<any zone>`.
        @oc expression {http.request.host}.endsWith('-oc.{{ opencode_public_domain }}') || {http.request.host}.endsWith('-oc.{{ docker_services_internal_domain }}')
        handle @oc {
            reverse_proxy http://caddy-opencode:80 {
                header_up Host {http.request.host}
                header_up X-Forwarded-Proto https
                transport http {
                    dial_timeout 5s
                    response_header_timeout 30s
                }
            }
        }

        # Only the names edge is configured to send reach this listener.
        handle {
            respond "unknown host" 404
        }
    }
}

# In-container debug endpoint (not published on the host).
:80 {
    respond "Caddy debug: OK"
}
