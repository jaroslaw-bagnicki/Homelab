# Origin Caddy for both zones: the edge proxy terminates TLS and hands the whole
# hostname here with `Host` preserved (ADR 24 (2026-11-14 amendment)), so each service
# lists its public and its `.internal` address, and the edge proxy decides which of
# them an outside client ever sees.
http://cloud5.ovh:8080 {
    respond "lab — {host} — {time.now}"
}

http://hello.{{ docker_services_public_domain }}:8080, http://hello.{{ docker_services_internal_domain }}:8080 {
    reverse_proxy hello:80
}

http://portainer.{{ docker_services_public_domain }}:8080, http://portainer.{{ docker_services_internal_domain }}:8080 {
    reverse_proxy portainer:9000 {
        header_up X-Forwarded-Proto https
    }
}

http://zot.{{ docker_services_public_domain }}:8080, http://zot.{{ docker_services_internal_domain }}:8080 {
    reverse_proxy zot:5000
}

# OpenCode instances — `<inst>-oc.<zone>` in either zone.
:8080 {
    route {
        @oc expression {http.request.host}.endsWith('-oc.{{ opencode_public_domain }}') || {http.request.host}.endsWith('-oc.{{ docker_services_internal_domain }}')
        handle @oc {
            reverse_proxy http://caddy-opencode:80 {
                header_up Host {http.request.host}
                header_up X-Forwarded-Proto https
                transport http {
                    dial_timeout 5s
                    response_header_timeout 30s
                }
            }
        }

        # Only the names edge is configured to send reach this listener.
        handle {
            respond "unknown host" 404
        }
    }
}

# In-container debug endpoint (not published on the host).
:80 {
    respond "Caddy debug: OK"
}
