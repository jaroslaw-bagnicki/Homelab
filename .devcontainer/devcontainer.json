{
  "name": "Homelab",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu26.04",

  // ── Features ──────────────────────────────────────────────────────
  "features": {
    // Docker CLI + Docker Compose (bind-mounts host Docker socket)
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    // PowerShell 7 — needed for Az module and repo scripts
    "ghcr.io/devcontainers/features/powershell:2": {},
    // Azure CLI — for Bicep validation and ad-hoc queries
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    // GitHub CLI — for PR/issue management, repo operations
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Node.js LTS — needed for npx-driven MCP servers (Azure MCP)
    "ghcr.io/devcontainers/features/node:2": {}
  },

  // ── VS Code customizations ────────────────────────────────────────
  "customizations": {
    "vscode": {
      "settings": {
        "workbench.colorTheme": "Dark Modern",
        "terminal.integrated.defaultProfile.linux": "pwsh",
        "terminal.integrated.profiles.linux": {
          "pwsh": {
            "path": "/usr/bin/pwsh"
          }
        },
        // transient git refs/objects make the watcher choke on every rebuild
        "files.watcherExclude": {
          "**/.git/refs/**": true,
          "**/.git/objects/**": true
        }
      },
      // Copilot + Copilot Chat are built into current VS Code — listing them
      // only produces "cannot be downgraded" errors on every rebuild.
      "extensions": [
        "ms-azuretools.vscode-bicep",
        "ms-vscode.powershell",
        "redhat.ansible",
        "bierner.markdown-mermaid",
        "ms-azuretools.vscode-docker",
        "github.vscode-pull-request-github",
        "vizards.deepseek-v4-for-copilot",
        "ms-azuretools.vscode-azure-mcp-server"
      ]
    }
  },

  // ── Post-create scripts ──────────────────────────────────────────
  // All steps run synchronously; only the Az PowerShell install is
  // backgrounded (huge module, can take minutes). The subshell around
  // nohup keeps the trailing & from backgrounding the whole && chain.
  // Check Az progress: tail -f /tmp/install-az.log
  "postCreateCommand": "bash .devcontainer/scripts/setup-ansible.sh && bash .devcontainer/scripts/setup-bicep.sh && pwsh -File .devcontainer/scripts/setup-step.ps1 && bash .devcontainer/scripts/setup-azure-mcp-prereqs.sh && pwsh -File .devcontainer/scripts/setup-profile.ps1 && ( nohup pwsh -File .devcontainer/scripts/setup-azps.ps1 > /tmp/install-az.log 2>&1 & )",

  // ── Remote user ───────────────────────────────────────────────────
  "remoteUser": "vscode"
}
