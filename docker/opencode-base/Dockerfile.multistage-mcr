# syntax=docker/dockerfile:1.7

ARG OPENCODE_BASE=ghcr.io/anomalyco/opencode:latest
ARG ALPINE_VERSION=3.24
ARG PWSH_VERSION=7.4-alpine-3.20

FROM ${OPENCODE_BASE} AS opencode_upstream
FROM mcr.microsoft.com/powershell:${PWSH_VERSION} AS pwsh_src

FROM alpine:${ALPINE_VERSION}

ARG AZCLI_VERSION=2.62.0
ARG BICEPCLI_VERSION=0.30.3
ARG GHCLI_VERSION=2.97.0

RUN apk add --no-cache \
        bash \
        ca-certificates \
        curl \
        git \
        icu-libs \
        libffi \
        libgcc \
        libstdc++ \
        openssl \
        py3-pip \
        py3-setuptools \
        py3-wheel \
        python3 \
 && apk add --no-cache --virtual .build-deps \
        gcc \
        musl-dev \
        libffi-dev \
        openssl-dev \
        python3-dev \
        tar

COPY --from=opencode_upstream /usr/local/bin/opencode /usr/local/bin/opencode

COPY --from=pwsh_src /opt/microsoft/powershell/7 /opt/microsoft/powershell/7
RUN ln -sf /opt/microsoft/powershell/7/pwsh /usr/bin/pwsh

RUN pip3 install --no-cache-dir --break-system-packages azure-cli==${AZCLI_VERSION} \
 && az --version | head -n 1

RUN pwsh -NoProfile -Command "Set-PSRepository -Name PSGallery -InstallationPolicy Trusted; Install-Module Az -Scope AllUsers -Force" \
 && pwsh -NoProfile -Command "Import-Module Az; (Get-Module Az).Version.ToString()"

RUN apk del .build-deps

RUN set -eux; \
    curl -fsSL "https://github.com/Azure/bicep/releases/download/v${BICEPCLI_VERSION}/bicep-linux-musl-x64" \
        -o /usr/local/bin/bicep; \
    chmod +x /usr/local/bin/bicep; \
    bicep --version

RUN set -eux; \
    curl -fsSL "https://github.com/cli/cli/releases/download/v${GHCLI_VERSION}/gh_${GHCLI_VERSION}_linux_amd64.tar.gz" \
        -o /tmp/gh.tar.gz; \
    tar -xzf /tmp/gh.tar.gz -C /tmp; \
    mv "/tmp/gh_${GHCLI_VERSION}_linux_amd64/bin/gh" /usr/local/bin/gh; \
    rm -rf /tmp/gh.tar.gz "/tmp/gh_${GHCLI_VERSION}_linux_amd64"; \
    gh --version

COPY tests/verify-base.sh /usr/local/bin/verify-base.sh
RUN chmod +x /usr/local/bin/verify-base.sh

RUN command -v git && git --version \
 && command -v pwsh && pwsh -Version \
 && command -v az && az --version | head -n 1 \
 && command -v bicep && bicep --version \
 && command -v gh && gh --version \
 && opencode --version \
 && pwsh -NoProfile -Command "if (-not (Get-Module Az -ListAvailable)) { exit 1 }"

WORKDIR /workspaces
ENTRYPOINT ["opencode"]